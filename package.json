{
  "name": "pi-fast-resume",
  "version": "0.1.0-local",
  "description": "Instant /resume for pi: original session picker backed by a background worker-thread metadata index",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "resume",
    "session-picker",
    "worker-threads"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "@types/better-sqlite3": "^7.6.13",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
